# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
TRUST_PROXY=1
# Database
MONGODB_URI=mongodb://localhost:27017/uae-work-hub
MONGODB_TEST_URI=mongodb://localhost:27017/uae-work-hub-test

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here
REFRESH_TOKEN_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_EMAIL_SECRET=your-email-token-secret-here
JWT_RESET_SECRET=your-password-reset-secret-here

# UAE Pass OAuth (UAE Government Authentication)
UAE_PASS_CLIENT_ID=your-uae-pass-client-id
UAE_PASS_CLIENT_SECRET=your-uae-pass-client-secret
UAE_PASS_REDIRECT_URI=http://localhost:3000/auth/uae-pass/callback
UAE_PASS_API_URL=https://uaepass.gov.ae/api
# External APIs
DUBAI_2040_API_KEY=your-dubai-2040-api-key
UAE_PRAYER_TIMES_API_KEY=your-prayer-times-api-key
DUBAI_MUNICIPALITY_API_KEY=your-dubai-municipality-api-key

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Select Redis implementation: prod | dev | none
REDIS_MODE=dev
# File Upload
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads
AWS_S3_BUCKET=uae-work-hub-files
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=me-south-1

# Email (UAE-compliant email service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@uaeworkhub.ae
SMTP_PASS=your-email-password

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-ai-service-key

# Security
CORS_ORIGIN=http://localhost:3000,https://uaeworkhub.ae
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
COOKIE_DOMAIN=localhost
# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Cultural Features
DEFAULT_TIMEZONE=Asia/Dubai
DEFAULT_LANGUAGE=ar-AE
HIJRI_CALENDAR_ENABLED=true

# Frontend/App URLs
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Metrics
ENABLE_PROMETHEUS_METRICS=true

# Tracing (OpenTelemetry)
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=uae-work-hub-api
# Optional, comma-separated: key=value,key2=value2
OTEL_EXPORTER_OTLP_HEADERS=

# Readiness policy
# In production NODE_ENV=production will require Redis to be healthy automatically.
# You can force this behavior in non-production by setting REQUIRE_REDIS_READY=true
REQUIRE_REDIS_READY=false

# CORS policy
# In production, requests without Origin are blocked by default. Set to false to permit.
REQUIRE_ORIGIN_IN_PROD=false
